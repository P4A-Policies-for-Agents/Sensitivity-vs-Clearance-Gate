# C1 demo environment — copy to demo/env.local.sh (gitignored) and edit.
# The base URL of the Flex Gateway route that fronts the mocked "items" API with
# the Sensitivity vs Clearance Gate applied. Use the omni-gw-small public URL
# (omni-gw-ps-large is internal-only and will 404 from your laptop).
export C1_GW_URL="https://<your-omni-gw-small-host>/items"

# Optional: hit the mocked upstream directly (policy NOT applied) to show the raw
# body the gateway would otherwise have returned.
export C1_RAW_URL="https://<your-a2d-mock-host>/items"

# If you switch demo/config.json to a real judge, put the key here (NOT in git):
# export OPENROUTER_API_KEY="sk-or-..."
